# Copy this to .env.jetson in the repository root. .env.jetson is ignored by git.
JETSON_SSH_HOST=192.168.1.12
JETSON_SSH_USER=weizheng
JETSON_SSH_PORT=22
JETSON_REPO_DIR=~/code/jetson-vlm-lab

# Prefer SSH keys. If you must use a password locally, keep it only in .env.jetson.
# Optional custom SSH binary. Useful from WSL when Windows OpenSSH has Tailscale
# routing and keys/agent, e.g. /mnt/c/Windows/System32/OpenSSH/ssh.exe.
# JETSON_SSH_BIN=ssh
# JETSON_SSH_PASSWORD=
# JETSON_SSH_PASSWORD_FILE=
# JETSON_SSH_PASSWORD_HELPER=auto
# Set JETSON_SSH_PASSWORD_HELPER=none to ignore a password value and force
# key/agent-based SSH through JETSON_SSH_BIN.

# Optional: run sudo jetson_clocks before remote optimization sweeps.
# Leave off for ordinary dry-runs; enable for promotion/comparison sweeps.
# JETSON_REMOTE_PREPARE_MAX_CLOCKS=0
# Optional: drop page cache and compact memory before every remote sweep variant preflight.
# Requires sudo password in this ignored env file; do not pass it on CLI.
# JETSON_REMOTE_DROP_CACHES_BEFORE_VARIANT=0
# Optional: repeat each drop-cache/compact-memory prepare pass. Default is 1.
# JETSON_REMOTE_MEMORY_PREPARE_ATTEMPTS=1
# Optional: write Qwen selector memory diagnostics sidecars. Default is 1.
# JETSON_REMOTE_QWEN3_INSTRUCT_MEMORY_DIAGNOSTICS=1
# Optional: also write a read-only sudo diagnostics sidecar when debugfs paths
# are unreadable in the regular Qwen selector sidecar. Default is 0.
# JETSON_REMOTE_QWEN3_INSTRUCT_MEMORY_DIAGNOSTICS_SUDO=0
# JETSON_REMOTE_SUDO_PASSWORD=

# Optional: fail remote suite wrappers when compare marks any row as non-cached startup evidence.
# JETSON_CURRENT_DEFAULTS_FAIL_ON_STARTUP_PRECHECK=0
# JETSON_LIGHTWEIGHT_FAIL_ON_STARTUP_PRECHECK=0
# JETSON_TENCENT_TEXT_FAIL_ON_STARTUP_PRECHECK=0

# Optional: fail remote suite wrappers when compare marks any row as non-ranking
# because cached-startup evidence is missing under --ranking-require-startup-precheck.
# JETSON_CURRENT_DEFAULTS_FAIL_ON_RANKING_PRECHECK=0
# JETSON_LIGHTWEIGHT_FAIL_ON_RANKING_PRECHECK=0
# JETSON_TENCENT_TEXT_FAIL_ON_RANKING_PRECHECK=0

# Extra SSH options are split on spaces.
# JETSON_SSH_OPTS=-o ConnectTimeout=10
# Local TCP precheck timeout in seconds for scripts/jetson/check_remote_access.sh.
# JETSON_REMOTE_ACCESS_TCP_TIMEOUT=5
# TCP probe mode: auto tries nc first and can fall back to PowerShell from WSL;
# use nc or powershell to force one mode.
# JETSON_REMOTE_ACCESS_TCP_PROBE=auto
# Optional advisory ICMP probe for scripts/jetson/check_remote_access.sh; TCP remains the SSH gate.
# JETSON_REMOTE_ACCESS_ICMP_PROBE=1
# JETSON_REMOTE_ACCESS_ICMP_TIMEOUT=3
# For 100.64.0.0/10 Tailscale targets, check_remote_access.sh also prints
# advisory tailnet_probe=... status without changing the TCP gate result.
# Optional host-side tools for WSL/Windows setups.
# JETSON_TAILSCALE_BIN=/mnt/c/Program Files/Tailscale/tailscale.exe
# JETSON_POWERSHELL_BIN=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# Enable the same local TCP precheck inside run_remote_optimization_sweep.sh before any SSH command.
# JETSON_REMOTE_ACCESS_PREFLIGHT=0

# Optional: customize scripts/jetson/run_remote_preflight_smoke.sh.
# JETSON_REMOTE_SMOKE_RUN_PREFIX=remote-preflight-smoke
# JETSON_REMOTE_SMOKE_VARIANT=gemma-q4-baseline-gpu12-b512-u512-kvq8
# JETSON_REMOTE_SMOKE_SKIP_ACCESS_CHECK=0
